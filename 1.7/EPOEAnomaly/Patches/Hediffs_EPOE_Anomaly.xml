<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ================================================================
       EPOE glitterworld AI cores, Anomaly values (EPOE lowers most of them when Anomaly is active).
       The EMP reaction and the socialFightChanceFactor stay active at zero charge.
       ================================================================ -->

  <!-- ConstructorCore: reverses the construction bonuses
       Targets: ConstructorCore -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="ConstructorCore") and not(comps)]</xpath>
    <value><comps /></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="ConstructorCore") and not(comps/li[@Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable"])]/comps</xpath>
    <value>
        <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
          <maxCharge>150</maxCharge>
          <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
          <depletedConsequences>
            <statOffsets>
              <ConstructionSpeed>-0.10</ConstructionSpeed>
              <ConstructSuccessChance>-0.15</ConstructSuccessChance>
              <FixBrokenDownBuildingSuccessChance>-0.15</FixBrokenDownBuildingSuccessChance>
              <SmoothingSpeed>-0.10</SmoothingSpeed>
            </statOffsets>
          </depletedConsequences>
        </li>
    </value>
  </Operation>


<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ================================================================
       Chargeable Bionics: Expanded Prosthetics and Organ Engineering - Forked (vat.epoeforked)
       Written against EPOE Forked 4.4.7. Each group notes what stays active at zero charge.
       Excluded on purpose: HookHand, SteelArm, EyePatch, EarBandage, GoldenEye,
       ArtificialNose, EPOE_ScytherBlade (passive, cosmetic or melee), the optimizer
       hediffs (biological) and all injury, EMP and glitch status hediffs.
       ================================================================ -->

  <!-- ================================================================
       SHARED NAMES: EPOE redefines these vanilla HediffDefs with different values.
       The core patches in 1.6/Base already add the rechargeable comp to them (to the
       EPOE node as well, since both share the defName). This file only corrects the
       depleted consequence. LoadFolders.xml lists this folder BEFORE 1.6/Base so that
       these corrections run AFTER the core patches added the comp. Each operation
       is narrowed to EPOE's ParentName and does nothing if the comp is missing.
       ================================================================ -->

  <!-- EPOE sets partEfficiency 0.80 (core assumed 0.85, 0.50 and 0.65): depleted leaves exactly half
       Targets: SimpleProstheticLeg, SimpleProstheticArm, CochlearImplant -->
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="SimpleProstheticLeg" or defName="SimpleProstheticArm" or defName="CochlearImplant") and @ParentName="addedPartSimple"]/comps/li[@Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable"]/depletedConsequences/partEfficiencyOffset</xpath>
    <value><partEfficiencyOffset>-0.40</partEfficiencyOffset></value>
  </Operation>

  <!-- EPOE sets SimpleProstheticHeart partEfficiency 0.75 (core assumed 0.80): depleted leaves about half
       Targets: SimpleProstheticHeart -->
  <Operation Class="PatchOperationReplace">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="SimpleProstheticHeart") and @ParentName="addedPartSurrogate"]/comps/li[@Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable"]/depletedConsequences/partEfficiencyOffset</xpath>
    <value><partEfficiencyOffset>-0.38</partEfficiencyOffset></value>
  </Operation>

  <!-- BionicSpine: EPOE adds CarryingCapacity +10 on top of the core partEfficiency.
       The depleted consequence gets the matching -10 (the core patch only has partEfficiencyOffset).
       BionicJaw, BionicHeart and BionicStomach need no correction: efficiency 1.25 as in core. -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/HediffDef[defName="BionicSpine" and @ParentName="addedPartBionics"]/comps/li[@Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable"]/depletedConsequences[not(statOffsets)]</xpath>
    <value>
      <statOffsets>
        <CarryingCapacity>-10</CarryingCapacity>
      </statOffsets>
    </value>
  </Operation>

  <!-- ================================================================
       NEW EPOE DEFS. Each group: (1) ensure <comps>, (2) append one rechargeable
       comp unless the def already has one. Both operations use success=Always so a
       target removed by EPOE's XML Extensions options or by another mod is skipped
       quietly. Efficiency rules follow the core patches: simple parts keep about
       half, bionic and advanced parts fall to 0.50 absolute.
       ================================================================ -->

  <!-- ===== SIMPLE REPLACEMENT PARTS (60 charge, gated by Enable prosthetic patches) ===== -->

  <!-- Simple prosthetics, partEfficiency 0.80: depleted leaves 0.40
       Targets: LightReceptor, SimpleSpine, SimpleProstheticHand, SimpleProstheticFoot, SimpleProstheticFinger, SimpleProstheticToe -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="LightReceptor" or defName="SimpleSpine" or defName="SimpleProstheticHand" or defName="SimpleProstheticFoot" or defName="SimpleProstheticFinger" or defName="SimpleProstheticToe") and not(comps)]</xpath>
    <value><comps /></value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>Defs/HediffDef[(defName="LightReceptor" or defName="SimpleSpine" or defName="SimpleProstheticHand" or defName="SimpleProstheticFoot" or defName="SimpleProstheticFinger" or defName="SimpleProstheticToe") and not(comps/li[@Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable"])]/comps</xpath>
    <value>
        <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
          <maxCharge>60</maxCharge>
          <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
          <depletedConsequences>
            <partEfficiencyOffset>-0.40</partEfficiencyOffset>
          </depletedConsequences>
        </li>
    </value>
  </Operation>


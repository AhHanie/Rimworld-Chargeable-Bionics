  <!-- ==== TIER 2 (maxCharge 150), charge-only ====
       LTS_ArchotechBlackbox's skill-decay immunity is a zero stat factor and cannot be
       reversed with a zero factor consequence. LTS_Vanguard is purely ability-driven. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="LTS_ArchotechBlackbox" or defName="LTS_Vanguard"]/comps</xpath>

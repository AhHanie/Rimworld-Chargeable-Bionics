  <!-- ================================================================
       PASS 2: Add rechargeable comp. Grouped by tier and consequence.
       ================================================================ -->

  <!-- ==== TIER 1 (maxCharge 100), straight stat cancellation ==== -->

  <!-- HackingPortImplant: cancels HackingSpeed factor x2 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="HackingPortImplant"]/comps</xpath>
    <value>
      <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
        <maxCharge>100</maxCharge>
        <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
        <depletedConsequences>
          <statFactors>
            <HackingSpeed>0.5</HackingSpeed>
          </statFactors>
        </depletedConsequences>
      </li>
    </value>
  </Operation>

  <!-- StrengthEnhancer: cancels CarryingCapacity +25 (+ optional VEF mass carry) and MeleeDamageFactor x1.25 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="StrengthEnhancer"]/comps</xpath>
    <value>
      <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
        <maxCharge>100</maxCharge>
        <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
        <depletedConsequences>
          <statOffsets>
            <CarryingCapacity>-25</CarryingCapacity>
            <VEF_MassCarryCapacity MayRequire="oskarpotocki.vanillafactionsexpanded.core">-25</VEF_MassCarryCapacity>
          </statOffsets>
          <statFactors>
            <MeleeDamageFactor>0.8</MeleeDamageFactor>
          </statFactors>
        </depletedConsequences>
      </li>
    </value>
  </Operation>


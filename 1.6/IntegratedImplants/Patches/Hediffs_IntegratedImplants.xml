  <!-- ==== TIER 1 (maxCharge 100), charge-only ====
       Ability-driven, verb-driven, custom-comp, or additive-only effects that the
       framework cannot cancel via StatDefs. No depletedConsequences until custom
       compat code is added. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="BiochameleonDevice" or defName="LTS_FireSupressionSystem" or defName="CryptoWakeImplant" or defName="LTS_Neurostreamer" or defName="LTS_CommsImplant" or defName="LTS_NeuralStunner" or defName="LTS_BrainDetonator" or defName="LTS_Voicelock" or defName="LTS_StealthSystem" or defName="LTS_ShoulderRocketPod" or defName="LTS_ShoulderMortar" or defName="LTS_GourmandTongue" or defName="LeftExtraBionicArm" or defName="RightExtraBionicArm" or defName="LeftExtraPowerClaw" or defName="RightExtraPowerClaw"]/comps</xpath>
    <value>
      <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
        <maxCharge>100</maxCharge>
        <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
      </li>
    </value>
  </Operation>

  <!-- ==== TIER 2 (maxCharge 150), straight stat cancellation ==== -->

  <!-- PsychicLevitator: cancels MoveSpeed +0.20. Zero-factor TrapSpringChance immunity
       cannot be reversed with a zero factor consequence; left uncancelled. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="PsychicLevitator"]/comps</xpath>
    <value>
      <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">

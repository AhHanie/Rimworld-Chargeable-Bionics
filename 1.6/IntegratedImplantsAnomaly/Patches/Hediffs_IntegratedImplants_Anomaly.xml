<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ================================================================
       PASS 1: Ensure every target HediffDef has a <comps> node.
       LTS_ImplantedDeadlife (one-shot implanted explosive) is intentionally
       excluded from Phase 1 scope.
       ================================================================ -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="LeftExtraNerveShredderClaw"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[defName="LeftExtraNerveShredderClaw"]</xpath>
      <value><comps /></value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="RightExtraNerveShredderClaw"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[defName="RightExtraNerveShredderClaw"]</xpath>
      <value><comps /></value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="LeftExtraDeadlifeVenomClaw"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[defName="LeftExtraDeadlifeVenomClaw"]</xpath>
      <value><comps /></value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/HediffDef[defName="RightExtraDeadlifeVenomClaw"]/comps</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/HediffDef[defName="RightExtraDeadlifeVenomClaw"]</xpath>
      <value><comps /></value>
    </nomatch>
  </Operation>

  <!-- ================================================================
       PASS 2: Add rechargeable comp.
       Both claw pairs are verb-driven melee weapons with no fixed
       cancellable stat offset (only the per-stage mastery ramp, which a
       flat depleted consequence cannot represent). Charge-only.
       ================================================================ -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="LeftExtraNerveShredderClaw" or defName="RightExtraNerveShredderClaw" or defName="LeftExtraDeadlifeVenomClaw" or defName="RightExtraDeadlifeVenomClaw"]/comps</xpath>
    <value>
      <li Class="Chargeable_Hediffs_Framework.HediffCompProperties_Rechargeable">
        <maxCharge>100</maxCharge>
        <chargeDecayPerTick>0.0001666667</chargeDecayPerTick>
      </li>
    </value>
  </Operation>

</Patch>

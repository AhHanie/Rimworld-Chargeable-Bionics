  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalBionicBuoyancy"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalBionicBuoyancy"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalBionicWing"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalBionicWing"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalShrinker"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalShrinker"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalEnlarger"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalEnlarger"]</xpath><value><comps /></value></nomatch></Operation>

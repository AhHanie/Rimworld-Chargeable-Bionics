  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticTail"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticTail"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticJaw"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticJaw"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticHeart"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalProstheticHeart"]</xpath><value><comps /></value></nomatch></Operation>

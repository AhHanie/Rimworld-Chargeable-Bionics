<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Alpha Implants 1.6 core animal implants. Optional 1.6 DLC integrations
       are patched in their corresponding DLC-gated compatibility folders -->

  <!-- PASS 1: Ensure each target has its own comps node before adding the
       rechargeable comp. Keep these checks per-def: a matching def's comps
       must never suppress creation for another target that lacks one. -->
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalBionicTail"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalBionicTail"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalBionicJaw"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalBionicJaw"]</xpath><value><comps /></value></nomatch></Operation>
  <Operation Class="PatchOperationConditional"><xpath>Defs/HediffDef[defName="AI_AnimalBionicHeart"]/comps</xpath><nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="AI_AnimalBionicHeart"]</xpath><value><comps /></value></nomatch></Operation>
